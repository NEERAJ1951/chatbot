# ==========================================
# OpenRouter AI & Chatbot Configuration
# ==========================================

OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL=openrouter/free
PORT=5000

# Security & Authentication
SECRET_KEY=upsc-mentor-ai-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite zero-setup local default)
DATABASE_URL=sqlite:///./upsc_mentor.db

# Optional Google Gemini Fallback Key
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# RAG Knowledge Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35
