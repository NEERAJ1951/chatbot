# ==========================================
# AntiGravity UPSC Mentor AI - Environment Configuration
# ==========================================

# OpenRouter AI Configuration (Primary LLM Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=45.0
MAX_HISTORY_MESSAGES=8

# Security & Authentication
SECRET_KEY=upsc-mentor-ai-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Option 1 (Zero-setup local SQLite / Vercel /tmp fallback):
DATABASE_URL=sqlite:///./upsc_mentor.db
# Option 2 (Production PostgreSQL e.g. Neon, Supabase, Railway):
# DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS & Domain Configuration
# Comma-separated list of allowed origins. Note: *.vercel.app is automatically allowed in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
SITE_URL=https://your-frontend.vercel.app

# Optional Google Gemini Fallback Key
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# RAG Knowledge Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# Server Port (for local uvicorn runs)
PORT=5000
