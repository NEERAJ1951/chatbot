# ==========================================
# Frontend Environment Variables (Vercel Deployed Frontend)
# ==========================================

# Production Backend API URL (e.g. deployed Vercel backend)
# In development, leave empty or unset to use Vite local proxy (/api -> http://127.0.0.1:5000)
# In production on Vercel, set this in your Vercel Project Settings > Environment Variables:
VITE_API_URL=https://your-backend.vercel.app

